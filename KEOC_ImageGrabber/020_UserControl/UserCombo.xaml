<UserControl x:Class="FalconWpf.UserCombo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FalconWpf"
             mc:Ignorable="d" 
             x:Name="uc" Margin="3" MinHeight="20">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=uc, Path=UCBTitleWidth}"/>
            <ColumnDefinition Width="{Binding ElementName=uc, Path=UCBValueWidth}"/>
            <ColumnDefinition Width="{Binding ElementName=uc, Path=UCBUnitWidth}"/>
        </Grid.ColumnDefinitions>
        
        <Label      Grid.Column="0" 
                    Name="uc_Title" 
                    Content ="{Binding ElementName=uc, Path=UCBTitle}" 
                    VerticalContentAlignment="{Binding ElementName=uc, Path=UCBTitleVerticalAlign}"
                    HorizontalContentAlignment="{Binding ElementName=uc, Path=UCBTitleHorizontalAlign}" 
                    Background="{Binding ElementName=uc, Path=UCBTitleBackground}"
                    Foreground="{Binding ElementName=uc, Path=UCBTitleForeground, TargetNullValue=Black}"
                    BorderBrush="{Binding ElementName=uc, Path=UCBTitleBorderBrush, TargetNullValue=Black}"
                    BorderThickness="{Binding ElementName=uc, Path=UCBTitleBorderThickness, TargetNullValue=0}"
                    Padding="0"  
                    MinHeight="20" 
                    MinWidth="40"
                    Margin="0,0,5,0"
                    />

        <ComboBox   Grid.Column="1" Name="uc_Combo" 
                    Text    ="{Binding ElementName=uc, Path=UCBValue}" 
                    VerticalAlignment="{Binding ElementName=uc, Path=UCBValueVerticalAlign}"
                    HorizontalAlignment="{Binding ElementName=uc, Path=UCBValueHorizontalAlign}"
                    VerticalContentAlignment="{Binding ElementName=uc, Path=UCBValueContentVerticalAlign}"
                    HorizontalContentAlignment="{Binding ElementName=uc, Path=UCBValueContentHorizontalAlign}"
                    Background="{Binding ElementName=uc, Path=UCBValueBackground}"
                    Foreground="{Binding ElementName=uc, Path=UCBValueForeground, TargetNullValue=Black}"
                    BorderBrush="{Binding ElementName=uc, Path=UCBValueBorderBrush, TargetNullValue=Black}"
                    BorderThickness="{Binding ElementName=uc, Path=UCBValueBorderThickness, TargetNullValue=0}"
                    ItemsSource="{Binding ElementName=uc, Path=UCBItemSource, TargetNullValue=0}"
                    Padding="0"  
                    MinHeight="20"
                    MinWidth="40"
                    SelectionChanged="Uc_Combo_SelectionChanged"
                    SelectedIndex="{Binding ElementName=uc, Path=UCBSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
        
        <Label      Grid.Column="2" 
                    Name="uc_Unit"  
                    Content ="{Binding ElementName=uc, Path=UCBUnit}"  
                    VerticalContentAlignment="{Binding ElementName=uc, Path=UCBUnitVerticalAlign}"
                    HorizontalContentAlignment="{Binding ElementName=uc, Path=UCBUnitHorizontalAlign}"   
                    Background="{Binding ElementName=uc, Path=UCBUnitBackground}"
                    Foreground="{Binding ElementName=uc, Path=UCBUnitForeground, TargetNullValue=Black}"
                    BorderBrush="{Binding ElementName=uc, Path=UCBUnitBorderBrush, TargetNullValue=Black}"
                    BorderThickness="{Binding ElementName=uc, Path=UCBUnitBorderThickness, TargetNullValue=0}"
                    Padding="0"  
                    MinHeight="20" 
                    MinWidth="30"
                    Margin="5,0,0,0"/>
    </Grid>
</UserControl>
