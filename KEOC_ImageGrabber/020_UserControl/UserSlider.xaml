<UserControl x:Class="FalconWpf.UserSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FalconWpf"
             mc:Ignorable="d" x:Name="uc" >
    <Grid Margin="3,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=uc, Path=USTitleWidth}"/>
            <ColumnDefinition Width="{Binding ElementName=uc, Path=USSliderWidth}"/>
            <ColumnDefinition Width="{Binding ElementName=uc, Path=USValueWidth}"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" 
               Name="title"  
               Content="{Binding ElementName=uc, Path=USTitle}" 
               VerticalAlignment="{Binding ElementName=uc, Path=USTitleVerticalAlign}"
               HorizontalAlignment="{Binding ElementName=uc, Path=USTitleHorizontalAlign}"
               VerticalContentAlignment="{Binding ElementName=uc, Path=USTitleContentVerticalAlign}"
               HorizontalContentAlignment="{Binding ElementName=uc, Path=USTitleContentHorizontalAlign}" 
               Background="{Binding ElementName=uc, Path=USTitleBackground}"
               Foreground="{Binding ElementName=uc, Path=USTitleForeground, TargetNullValue=Black}"
               BorderBrush="{Binding ElementName=uc, Path=USTitleBorderBrush, TargetNullValue=Black}"
               BorderThickness="{Binding ElementName=uc, Path=USTitleBorderThickness, TargetNullValue=0}"
               Padding="0"
               Margin="2,1"
               />
        <Grid Name="gd_Slider"  Grid.Column="1">
        <Slider Grid.Column="1" 
                Name="slider" 
                VerticalAlignment="{Binding ElementName=uc, Path=USSliderVerticalAlign}"
                HorizontalAlignment="{Binding ElementName=uc, Path=USSliderHorizontalAlign}"
                VerticalContentAlignment="{Binding ElementName=uc, Path=USSliderContentVerticalAlign}"
                HorizontalContentAlignment="{Binding ElementName=uc, Path=USSliderContentHorizontalAlign}"
                Width="{Binding ElementName=gd_Slider, Path=ActualWidth}"
                TickPlacement="BottomRight" 
                TickFrequency="{Binding ElementName=uc, Path=USTickFrequency}" 
                IsSnapToTickEnabled="True" 
                Minimum="{Binding ElementName=uc, Path=USMinimum}" 
                Maximum="{Binding ElementName=uc, Path=USMaximum}" 
                Value="{Binding ElementName=uc, Path=USValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ValueChanged="Slider_ValueChanged"
                />
        </Grid>
        <TextBox Grid.Column="2" 
                 Text="{Binding ElementName=slider, Path=Value, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="{Binding ElementName=uc, Path=USValueVerticalAlign}"
                 HorizontalAlignment="{Binding ElementName=uc, Path=USValueHorizontalAlign}" 
                 VerticalContentAlignment="{Binding ElementName=uc, Path=USValueContentVerticalAlign}"
                 HorizontalContentAlignment="{Binding ElementName=uc, Path=USValueContentHorizontalAlign}"
                 Background="{Binding ElementName=uc, Path=USValueBackground}"
                 Foreground="{Binding ElementName=uc, Path=USValueForeground}"
                 BorderBrush="{Binding ElementName=uc, Path=USValueBorderBrush}"
                 BorderThickness="{Binding ElementName=uc, Path=USValueBorderThickness}"
                 Height="{Binding ElementName=uc, Path=USValueHeight}"
                 PreviewMouseDown="Textbox_Down"
                 Margin="2,1"
                 MinWidth="30"/>
    </Grid>
</UserControl>
