      d:DesignHeight="604" d:DesignWidth="1260"
      Title="Page_Main">

    <Page.DataContext>
        <local:Page_MainDataContext x:Name="datacontext"/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <UniformGrid Columns="1" Rows="1">
            <GroupBox>
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cam1" Margin="3,0"/>
                        <uc:UserButton Content="View" CornerRadius="3" Click="bn_Cam1ViewImage_Click"/>
                        <uc:UserButton Content="Clear" CornerRadius="3"  Click="bn_Cam1ViewClear_Click"/>
                    </StackPanel>
                </GroupBox.Header>
                <uc:ImageViewer x:Name="imgview1"/>
            </GroupBox>
