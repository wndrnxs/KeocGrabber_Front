<Window x:Class="KeocGrabber_Front.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeocGrabber_Front"
        xmlns:uc="clr-namespace:FalconWpf"
        mc:Ignorable="d"
        Title="KEOC FrontAngleView" Height="720" Width="1280" Closing="Window_Closing" MinWidth="1280" MinHeight="720">
    <Window.DataContext>
        <local:MainWindowDataContext x:Name="datacontext"/>
    </Window.DataContext>
    
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="800"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding CurrRecipe, StringFormat=Current Recipe : {0}}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <StackPanel.Resources>
                        <Style TargetType="uc:UserButton">
                            <Setter Property="Width" Value="150"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </StackPanel.Resources>
                    <uc:UserButton x:Name="bnMain" CornerRadius="3" Content="Main" Click="bn_Menu_Click" Tag="0"/>
                    <uc:UserButton x:Name="bnSetup" CornerRadius="3" Content="Setup" Click="bn_Menu_Click" Tag="1"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <UniformGrid Rows="1">
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageAuthority}"/>
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageCommunication}"/>
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageSystem}"/>
                </UniformGrid>
            </Grid>
        </Grid>
        <Grid>
            <Frame x:Name="frame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </DockPanel>
</Window>
