<Window x:Class="KeocGrabber_Front.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeocGrabber_Front"
        xmlns:uc="clr-namespace:FalconWpf"
        mc:Ignorable="d"
        Title="KEOC FrontAngleView" Height="720" Width="1280" Closing="Window_Closing" MinWidth="1280" MinHeight="720">
    <Window.DataContext>
        <local:MainWindowDataContext x:Name="datacontext"/>
    </Window.DataContext>
    
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="800"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{Binding CurrRecipe, StringFormat=Current Recipe : {0}}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <StackPanel.Resources>
                        <Style TargetType="uc:UserButton">
                            <Setter Property="Width" Value="150"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </StackPanel.Resources>
                    <uc:UserButton x:Name="bnMain" CornerRadius="3" Content="Main" Click="bn_Menu_Click" Tag="0"/>
                    <uc:UserButton x:Name="bnSetup" CornerRadius="3" Content="Setup" Click="bn_Menu_Click" Tag="1"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <UniformGrid Rows="1">
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageAuthority}"/>
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageCommunication}"/>
                    <Frame NavigationUIVisibility="Hidden" Content="{Binding PageSystem}"/>
                </UniformGrid>
            </Grid>
        </Grid>
        <!-- 하단 상태 표시줄. 센서 입력 ON 시 청색 표시. 마우스를 올리면 입력 핀/감지 횟수 표시, 더블클릭 시 횟수 초기화. -->
        <Border DockPanel.Dock="Bottom" Height="20" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" ToolTip="{Binding SensorTip}" MouseLeftButtonDown="Sensor_MouseLeftButtonDown">
                <TextBlock Text="Sensor" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Ellipse Width="12" Height="12" Stroke="Gray" StrokeThickness="1" Margin="0,0,4,0">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Fill" Value="LightGray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SensorOn}" Value="True">
                                    <Setter Property="Fill" Value="DodgerBlue"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StackPanel>
        </Border>
        <Grid>
            <Frame x:Name="frame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </DockPanel>
</Window>
