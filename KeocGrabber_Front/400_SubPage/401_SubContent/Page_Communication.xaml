<Page x:Class="KEOC_ImageGrabber.Page_Communication"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KEOC_ImageGrabber"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_Communication">

    <Page.DataContext>
        <local:Page_CommnucationDataContext x:Name="datacontext"/>
    </Page.DataContext>

    <GroupBox Header="Comm">
        <UniformGrid Columns="1">
            <UniformGrid Rows="1">
                <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3" Margin="3" Background="{Binding ConnMaster }"> <TextBlock Text="Master"     VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3" Margin="3" Background="{Binding ConnGrabber    }"> <TextBlock Text="Grabber"     VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            </UniformGrid>
            <UniformGrid Rows="1">
                <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3" Margin="3" Background="{Binding ConnCam    }"> <TextBlock Text="Camera"     VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3" Margin="3" Background="{Binding ConnLight  }"> <TextBlock Text="Light"      VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            </UniformGrid>
        </UniformGrid>
    </GroupBox>
</Page>
