<Window x:Class="KeocGrabber_Front.Win_Authority"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeocGrabber_Front"
        xmlns:uc="clr-namespace:FalconWpf"
        mc:Ignorable="d"
        Title="Win_Authority" Height="250" Width="400" WindowStyle="None" ResizeMode="NoResize" BorderThickness="1" WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <local:Win_AutorityDataContext x:Name="datacontext"/>
    </Window.DataContext>

    <Grid Margin="5" FocusManager.FocusedElement="{Binding ElementName=pb_password}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="Authority" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="28" FontWeight="Bold"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Level" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <UniformGrid Rows="1" Grid.Column="1">
                    <uc:UserButton Content="Operator"       Click="bn_Op_Click" Background="{StaticResource UserOperator    }" CornerRadius="5" BorderThickness="{Binding ThickOP}" FontWeight="{Binding WeightOP}"/>
                    <uc:UserButton Content="Maintenance"    Click="bn_Ma_Click" Background="{StaticResource UserMaintenace  }" CornerRadius="5" BorderThickness="{Binding ThickMA}" FontWeight="{Binding WeightMA}"/>
                    <uc:UserButton Content="Engineer"       Click="bn_En_Click" Background="{StaticResource UserEngineer    }" CornerRadius="5" BorderThickness="{Binding ThickEN}" FontWeight="{Binding WeightEN}"/>
                </UniformGrid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Password" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <PasswordBox x:Name="pb_password" Grid.Column="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" KeyDown="pb_password_KeyDown"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <UniformGrid Rows="1">
                <uc:UserButton Content="OK" Margin="20" CornerRadius="5" Click="bn_Ok_Click"/>
                <uc:UserButton Content="Cancel" Margin="20" CornerRadius="5" Click="bn_Cancel_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
