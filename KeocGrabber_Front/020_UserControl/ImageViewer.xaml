<UserControl x:Class="FalconWpf.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FalconWpf"
             mc:Ignorable="d" 
             d:DesignHeight="282" d:DesignWidth="407" PreviewMouseWheel="UserControl_PreviewMouseWheel" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <VisualBrush x:Key="MyVisualBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute" Viewbox="0,0,20,20" ViewboxUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Background="White">
                    <!--
                    <Path Fill="#ffffffff" Data="M 0,0 L 5,0 L 5,5 L 0,5"/>
                    <Path Fill="#ffaaaaaa" Data="M 5,0 L 10,0 L 10,5 L 5,5"/>
                    <Path Fill="#ffaaaaaa" Data="M 0,5 L 5,5 L 5,10 L 0,10"/>
                    <Path Fill="#ffffffff" Data="M 5,5 L 10,5 L 10,10 L 5,10"/>
                    -->
                    <Path Data="M 0 20 L 20 0" Stroke="LightGray" />
                    <Path Data="M 0 0 L 20 20" Stroke="LightGray" />
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid>
            <UniformGrid Rows="1">
                <UniformGrid.Resources>
                    <Style TargetType="Image">
                        <Setter Property="Width" Value="24"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontWeight"       Value="Bold"/>
                        <Setter Property="FontSize"         Value="10"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </UniformGrid.Resources>
                <Button           Click="bn_Open_Click"     IsEnabled="{Binding IsEditor}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="icon/iv_open.png"/>
                        <TextBlock Text="Open"/>
                    </DockPanel>
                </Button>
                <Button           Click="bn_Save_Click"     IsEnabled="{Binding IsEditor}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="icon/iv_Save.png"/>
                        <TextBlock Text="Save"/>
                    </DockPanel>
                </Button>
                <Button           Click="bn_Scale1_Click">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="icon/iv_1x.png"/>
                        <TextBlock Text="1x"/>
                    </DockPanel>
                </Button>
                <Button           Click="bn_FitScale_Click">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="icon/iv_fit.png"/>
                        <TextBlock Text="Fit"/>
                    </DockPanel>
                </Button>
                <Button           Click="bn_ZoomIn_Click">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="icon/iv_zoomin.png"/>
                        <TextBlock Text="In"/>
                    </DockPanel>
                </Button>
                <Button           Click="bn_ZoomOut_Click">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="icon/iv_zoomout.png"/>
                        <TextBlock Text="Out"/>
                    </DockPanel>
                </Button>
                <Button           Click="bn_Mode_Click"     IsEnabled="{Binding IsEditor}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Width="24">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDraw}" Value="false">
                                            <Setter Property="Source" Value="icon/iv_move.png"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDraw}" Value="true">
                                            <Setter Property="Source" Value="icon/iv_select.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDraw}" Value="false">
                                            <Setter Property="Text" Value="Move"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDraw}" Value="true">
                                            <Setter Property="Text" Value="Draw"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Button>
                <ToggleButton    Click="bn_Halftone_Click" IsEnabled="{Binding IsEditor}" IsChecked="{Binding IsHalftone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Width="24">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHalftone}" Value="false">
                                            <Setter Property="Source" Value="icon/iv_halftoneoff.png"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHalftone}" Value="true">
                                            <Setter Property="Source" Value="icon/iv_halftoneon.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="Halftone"/>
                    </DockPanel>
                </ToggleButton>
            </UniformGrid>
        </Grid>
        <Grid Grid.Row="1" x:Name="ctrl_Grid" Background="{StaticResource MyVisualBrush}">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer  x:Name="lib_ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="lib_ScrollViewer_ScrollChanged">
                <Canvas x:Name="lib_Canvas" PreviewMouseDown="onMouseDown" PreviewMouseMove="onMouseMove" PreviewMouseUp="onMouseUp">
                    <Canvas.Resources>
                        <Style TargetType="Canvas">
                            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
                        </Style>
                    </Canvas.Resources>
                    <Canvas.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform  x:Name="myScaleTransform"/>
                        </TransformGroup>
                    </Canvas.LayoutTransform>
                    <!--<Image StretchDirection="DownOnly"/>-->
                </Canvas>
            </ScrollViewer>
            <StatusBar Grid.Row="1">
                <StatusBarItem Content="{Binding ColorR}" ContentStringFormat="R : {0,3}"/>
                <StatusBarItem Content="{Binding ColorG}" ContentStringFormat="G : {0,3}"/>
                <StatusBarItem Content="{Binding ColorB}" ContentStringFormat="B : {0,3}"/>
                <Separator/>
                <StatusBarItem Background="{Binding ColorRGB}" Width="25"/>
                <Separator/>
                <StatusBarItem Content="{Binding PosX}"         ContentStringFormat="X : {0:F1}"/>
                <StatusBarItem Content="{Binding PosY}"         ContentStringFormat="Y : {0:F1}"/>
                <Separator/>
                <StatusBarItem Content="{Binding ImageScale}"   ContentStringFormat="Scale : {0:F2}%" />
                <Separator/>
                <StatusBarItem Content="{Binding Width}"        ContentStringFormat="W : {0}" />
                <StatusBarItem Content="{Binding Height}"       ContentStringFormat="H : {0}" />
                <StatusBarItem Content="{Binding Channel}"      ContentStringFormat="C : {0}"/>
                <Separator/>
                <StatusBarItem Content="{Binding Fps}" ContentStringFormat="{}{0:F2} fps"/>
                <StatusBarItem/>
            </StatusBar>
        </Grid>
    </Grid>
</UserControl>
