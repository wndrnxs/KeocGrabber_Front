<ProgressBar x:Class="FalconWpf.UserProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FalconWpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Template="{DynamicResource ProgressTemplate}" Name="ucprg">
    <ProgressBar.Resources>
        <ControlTemplate x:Key="ProgressTemplate" TargetType="{x:Type ProgressBar}">
            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <DockPanel>
                    <Label Width="{Binding PrgLabelWidth, ElementName=ucprg}" HorizontalContentAlignment="{Binding PrgLabelHorizontalAlignment, ElementName=ucprg}" VerticalContentAlignment="Center">
                        <TextBlock Text="{Binding PrgLabel, ElementName=ucprg}" VerticalAlignment="Center"/>
                    </Label>
                    <Grid>
                        <ProgressBar x:Name="prg" Value="{TemplateBinding Value}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                        <TextBlock Text="{Binding ElementName=prg, Path=Value, StringFormat={}{0}%}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </ProgressBar.Resources>
</ProgressBar>
